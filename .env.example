# Backend
NODE_ENV=development
PORT=3000

# SQLite（Phase 1 用；Phase 2+ 可換 PostgreSQL 只需改 db.js dialect）
DATABASE_PATH=./data/antique_hunter.sqlite

# Claude API
ANTHROPIC_API_KEY=sk-ant-xxxxx
CLAUDE_MODEL=claude-haiku-4-5-20251001
# 可換 claude-sonnet-4-6 or claude-opus-4-7 若 Haiku 精度不夠

# Cloudflare R2（Phase 1 若不存原圖可先不用）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=antique-hunter-images

# Frontend
VITE_API_BASE_URL=http://localhost:3000/api
