# Backend
NODE_ENV=development
PORT=3000
# Cron 用（node-cron 排 08:00 追蹤 keyword），沒設走系統 default
TZ=Asia/Tokyo
# 部到 VPS 後改成前端 origin，例如 https://antique.example.com
# 開發模式(NODE_ENV=development)留 * 沒關係；production 模式務必改成實際 origin
CORS_ORIGIN=*

# API 金鑰（單人工具用的簡易防護，不是多使用者權限系統）
# 開發模式留空會放行所有請求；NODE_ENV=production 時留空會直接拒絕所有請求，逼自己部署前要設
# 前端對應的是 frontend/.env 的 VITE_API_KEY，兩邊要填一樣的值
# 注意：如果 frontend 也公開部署，這個值會被打包進前端 bundle，擋不住真的想繞過的人——
# 公網部署還是建議額外在 reverse proxy 加 Basic Auth 或限制 IP/VPN
API_KEY=

# SQLite（Phase 1 用；Phase 2+ 可換 PostgreSQL 只需改 db.js dialect）
DATABASE_PATH=./data/antique_hunter.sqlite

# Claude API
# 留空 = mock 模式（UI/流程都能跑但估價是假）。填了「任何非空字串」就會被當成已啟用去真的呼叫 API，
# 所以複製這份檔案成 .env 後，沒有真 key 的話，千萬別留下面這行不動，要整行清空或刪掉。
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001
# 可換 claude-sonnet-4-6 or claude-opus-4-7 若 Haiku 精度不夠

# Cloudflare R2（Phase 1 若不存原圖可先不用）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=antique-hunter-images

# Frontend
VITE_API_BASE_URL=http://localhost:3000/api
